<%- include('header') %>

  <header>
    <h1>Smart Phone Price to Performance Calculator</h1>
    <p>Compare phones across budgets and find the best value for your money with a customizable price-to-performance score.</p>
    <a href="/add" class="btn">+ Add New Phone</a>
  </header>

  <section class="budget-grid">
    <div class="budget-panel">
      <h2>Pick a price range</h2>
      <div class="price-pills">
        <% defaultPriceBuckets.forEach(function(bucket) { %>
          <button class="price-pill <%= (bucket.min === priceRange.min && bucket.max === priceRange.max) ? 'active' : '' %>" data-min="<%= bucket.min %>" data-max="<%= bucket.max %>">
            <%= bucket.label %>
          </button>
        <% }); %>
      </div>

      <div class="custom-range">
        <div>
          <label>Min price</label>
          <input type="number" id="min-price" value="<%= priceRange.min %>" min="0" step="500">
        </div>
        <div>
          <label>Max price</label>
          <input type="number" id="max-price" value="<%= priceRange.max %>" min="500" step="500">
        </div>
        <button id="apply-range" class="btn secondary">Apply range</button>
      </div>
    </div>
  </section>

  <section class="popular-section">
    <div class="list-head">
      <h2>Popular phones in <%= rangeLabel %></h2>
    </div>
    <div class="popular-grid">
      <% popularPhones.forEach(function(phone) { %>
        <div class="popular-card">
          <div class="phone-name"><%= phone.name %></div>
          <div class="phone-price">₹<%= Number(phone.price).toLocaleString('en-IN') %></div>
        </div>
      <% }); %>
    </div>
  </section>

  <details>
    <summary>How the Value Score is calculated</summary>
    <p>
      Each spec (benchmark score, RAM+storage, battery, refresh rate, camera) is scaled to
      0–100 relative to the other phones in the list, using min-max normalization:
      <code>(value - min) / (max - min) * 100</code>.
      Your sliders weight how much each category matters, producing a Performance Score out of 100.
      That score is then divided by price to get raw value-for-money, which is re-scaled to
      0–100 across the list to produce the Value Score ranked below.
    </p>
  </details>

  <div class="controls">
    <div class="control">
      <label><span>Performance</span><span id="v-performance"><%= weights.performance %></span></label>
      <input type="range" id="w-performance" min="0" max="100" value="<%= weights.performance %>">
    </div>
    <div class="control">
      <label><span>Memory</span><span id="v-memory"><%= weights.memory %></span></label>
      <input type="range" id="w-memory" min="0" max="100" value="<%= weights.memory %>">
    </div>
    <div class="control">
      <label><span>Battery</span><span id="v-battery"><%= weights.battery %></span></label>
      <input type="range" id="w-battery" min="0" max="100" value="<%= weights.battery %>">
    </div>
    <div class="control">
      <label><span>Display</span><span id="v-display"><%= weights.display %></span></label>
      <input type="range" id="w-display" min="0" max="100" value="<%= weights.display %>">
    </div>
    <div class="control">
      <label><span>Camera</span><span id="v-camera"><%= weights.camera %></span></label>
      <input type="range" id="w-camera" min="0" max="100" value="<%= weights.camera %>">
    </div>
  </div>

  <div class="list-head">
    <h2>Ranked</h2>
    <span id="count-label"><%= phones.length %> phones</span>
  </div>
  <div id="phone-list">
    <% phones.forEach(function(p, i) { %>
      <div class="row">
        <div class="rank"><%= i + 1 %></div>
        <div class="row-main">
          <div class="row-top">
            <span class="name"><%= p.name %></span>
            <span class="price">₹<%= p.price.toLocaleString('en-IN') %></span>
          </div>
          <div class="specs"><%= p.ram %>GB/<%= p.storage %>GB • <%= p.battery %>mAh • <%= p.refreshRate %>Hz • <%= p.cameraMP %>MP</div>
          <div class="bar-track"><div class="bar-fill" style="width:<%= p.valueScore.toFixed(1) %>%"></div></div>
        </div>
        <div class="score"><%= Math.round(p.valueScore) %></div>
      </div>
    <% }); %>
  </div>

<script>
  document.querySelectorAll('.price-pill').forEach((button) => {
    button.addEventListener('click', () => {
      const params = new URLSearchParams(window.location.search);
      params.set('min', button.dataset.min);
      params.set('max', button.dataset.max);
      window.location.search = params.toString();
    });
  });

  document.getElementById('apply-range')?.addEventListener('click', () => {
    const min = Number(document.getElementById('min-price').value || 0);
    const max = Number(document.getElementById('max-price').value || 50000);

    if (max < min) {
      alert('Max price must be greater than or equal to min price.');
      return;
    }

    const params = new URLSearchParams(window.location.search);
    params.set('min', Math.max(0, min));
    params.set('max', Math.max(500, max));
    window.location.search = params.toString();
  });

  function renderPhones(phones) {
    const list = document.getElementById('phone-list');
    document.getElementById('count-label').textContent = phones.length + ' phones';
    
    list.innerHTML = phones.map((p, i) => `
      <div class="row">
        <div class="rank">${i + 1}</div>
        <div class="row-main">
          <div class="row-top">
            <span class="name">${p.name}</span>
            <span class="price">₹${p.price.toLocaleString('en-IN')}</span>
          </div>
          <div class="specs">${p.ram}GB/${p.storage}GB • ${p.battery}mAh • ${p.refreshRate}Hz • ${p.cameraMP}MP</div>
          <div class="bar-track"><div class="bar-fill" style="width:${p.valueScore.toFixed(1)}%"></div></div>
        </div>
        <div class="score">${Math.round(p.valueScore)}</div>
      </div>
    `).join('');
  }

  async function updateRanks() {
    const weights = {
      performance: document.getElementById('w-performance').value,
      memory: document.getElementById('w-memory').value,
      battery: document.getElementById('w-battery').value,
      display: document.getElementById('w-display').value,
      camera: document.getElementById('w-camera').value,
    };

    ['performance', 'memory', 'battery', 'display', 'camera'].forEach(k => {
      document.getElementById('v-' + k).textContent = weights[k];
    });

    const params = new URLSearchParams(weights);
    try {
      const res = await fetch('/api/phones?' + params.toString());
      const newPhones = await res.json();
      renderPhones(newPhones);
    } catch (err) {
      console.error("Failed to update phones", err);
    }
  }

  document.querySelectorAll('input[type="range"]').forEach(el => {
    el.addEventListener('input', updateRanks);
  });
</script>

<%- include('footer') %>
