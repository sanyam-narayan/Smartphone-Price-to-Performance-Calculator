<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Smart Phone Price to Performance Calculator</title>
<!-- Simple favicon using data URI -->
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>📱</text></svg>">
<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap');

  :root {
    --bg: #10142b;
    --panel: #1a2049;
    --panel-alt: #232a5c;
    --text: #edeffb;
    --text-muted: #8c94c0;
    --accent: #e8a33d;
    --accent-soft: rgba(232, 163, 61, 0.16);
    --good: #4fbe86;
    --line: rgba(255, 255, 255, 0.09);
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', -apple-system, sans-serif;
    line-height: 1.5;
    padding: 32px 20px 60px;
  }

  .wrap { max-width: 760px; margin: 0 auto; }

  header h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 6px;
    letter-spacing: -0.01em;
  }

  header p {
    color: var(--text-muted);
    max-width: 46ch;
    margin: 0 0 20px;
    font-size: 0.95rem;
  }
  
  a.btn, button.btn {
    display: inline-block;
    padding: 8px 16px;
    background: var(--accent);
    color: #000;
    text-decoration: none;
    border-radius: 6px;
    font-weight: 600;
    margin-bottom: 20px;
    font-size: 0.9rem;
    border: none;
    cursor: pointer;
  }

  .btn.secondary {
    margin-bottom: 0;
    background: var(--panel-alt);
    color: var(--text);
    border: 1px solid var(--line);
  }

  .budget-grid,
  .popular-section {
    margin-bottom: 28px;
  }

  .budget-panel,
  .popular-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 18px 20px;
  }

  .price-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 12px 0 16px;
  }

  .price-pill {
    background: var(--panel-alt);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 8px 12px;
    cursor: pointer;
    font-size: 0.8rem;
  }

  .price-pill.active {
    background: var(--accent);
    color: #000;
    border-color: transparent;
    font-weight: 700;
  }

  .custom-range {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 12px;
    align-items: end;
  }

  .custom-range label {
    display: block;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 6px;
  }

  .custom-range input {
    width: 100%;
    background: var(--panel-alt);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 10px 12px;
  }

  .popular-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 12px;
    margin-top: 12px;
  }

  .popular-card {
    padding: 14px 16px;
  }

  .phone-name {
    font-weight: 600;
    margin-bottom: 4px;
  }

  .phone-price {
    color: var(--text-muted);
    font-size: 0.82rem;
  }

  details {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 14px 16px;
    margin-bottom: 28px;
    font-size: 0.9rem;
  }

  details summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--accent);
  }

  details p { color: var(--text-muted); margin: 10px 0 0; }
  details code {
    background: var(--panel-alt);
    padding: 1px 5px;
    border-radius: 4px;
    color: var(--text);
  }

  .controls {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 16px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 18px 20px 20px;
    margin-bottom: 28px;
  }

  .control label {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 8px;
  }

  .control label span:last-child {
    font-family: 'Space Grotesk', sans-serif;
    color: var(--accent);
    font-weight: 600;
  }

  input[type="range"] {
    -webkit-appearance: none;
    width: 100%;
    background: var(--panel-alt);
    height: 6px;
    border-radius: 3px;
    outline: none;
  }
  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 16px;
    height: 16px;
    background: var(--accent);
    border-radius: 50%;
    cursor: pointer;
  }
  
  .list-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 16px;
  }
  .list-head h2 { margin: 0; font-family: 'Space Grotesk', sans-serif; }
  #count-label { color: var(--text-muted); font-size: 0.9rem; }

  .row {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 12px;
    transition: transform 0.2s ease;
  }
  .row:hover { transform: translateY(-2px); border-color: rgba(255,255,255,0.15); }
  
  .rank {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--accent);
    width: 24px;
    text-align: center;
  }
  
  .row-main { flex: 1; min-width: 0; }
  
  .row-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 4px;
  }

  .name { font-weight: 600; }
  .price { color: var(--text-muted); font-size: 0.9rem; white-space: nowrap; }

  .specs {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-bottom: 8px;
  }

  .bar-track {
    height: 6px;
    background: var(--panel-alt);
    border-radius: 3px;
    overflow: hidden;
  }

  .bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--good));
    border-radius: 3px;
    transition: width 0.45s ease;
  }

  .score {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 1.15rem;
    width: 48px;
    text-align: right;
    flex-shrink: 0;
  }

  footer {
    margin-top: 28px;
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  @media (max-width: 520px) {
    .row-top { flex-direction: column; gap: 2px; }
    .price { font-size: 0.8rem; }
  }
  
  /* Form specific styles */
  .form-group {
    margin-bottom: 16px;
  }
  .form-group label {
    display: block;
    margin-bottom: 6px;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .form-group input, .form-group select {
    width: 100%;
    padding: 10px;
    border-radius: 6px;
    border: 1px solid var(--line);
    background: var(--panel-alt);
    color: var(--text);
    font-family: 'Inter', sans-serif;
  }
  button[type="submit"] {
    padding: 10px 20px;
    background: var(--accent);
    color: #000;
    border: none;
    border-radius: 6px;
    font-weight: 600;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
  }
</style>
</head>
<body>
<div class="wrap">
